# ── News API ─────────────────────────────────────────────────────────────────
# Free at https://newsapi.org (100 requests/day on free tier — plenty for this portfolio)
# Without this key the script falls back to Google News RSS.
NEWSAPI_KEY=your_newsapi_key_here

# ── Email settings ───────────────────────────────────────────────────────────
# The address the email comes FROM (must match SMTP_USER for Gmail)
EMAIL_FROM=you@gmail.com

# Where to send the daily digest (comma-separate multiple addresses)
EMAIL_TO=you@gmail.com

# SMTP server — defaults work for Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail: use your address + a Google App Password (not your regular password)
# https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# ── Dashboard settings ───────────────────────────────────────────────────────
# How many days back to search for news (7 = past week)
DAYS_BACK=7

# Max news articles shown per investment
MAX_ARTICLES=3
