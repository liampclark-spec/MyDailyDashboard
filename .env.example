# ── News API ─────────────────────────────────────────────────────────────────
# Free at https://newsapi.org (100 requests/day on free tier)
NEWSAPI_KEY=your_newsapi_key_here

# ── SendGrid ─────────────────────────────────────────────────────────────────
# Free at https://sendgrid.com (100 emails/day on free tier)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# The address the email comes FROM (must be verified in SendGrid)
EMAIL_FROM=you@example.com

# Where to send the daily digest (comma-separate for multiple)
EMAIL_TO=you@example.com

# ── Dashboard settings ───────────────────────────────────────────────────────
DAYS_BACK=7
MAX_ARTICLES=3
MAX_EPISODES=2
